---
const {
  title,
  text,
  imgSrc,
  videoSrc,
  featured = false,
} = Astro.props;

const isVideo = !!videoSrc;
---

<button
  type="button"
  class:list={[
    "world-tile relative w-full overflow-hidden rounded-3xl border border-white/10 bg-white/5 text-left hover:border-white/20 transition-colors duration-300",
    featured ? "aspect-[16/7]" : "aspect-[4/3]",
  ]}
  aria-pressed="false"
>
  {isVideo && (
    <video
      class="front-media absolute inset-0 h-full w-full object-cover pointer-events-none"
      src={videoSrc}
      muted
      loop
      playsinline
      autoplay
      preload="metadata"
    />
  )}
  {!isVideo && (
    <img
      class="front-media absolute inset-0 h-full w-full object-cover pointer-events-none"
      src={imgSrc}
      alt={title}
      loading="lazy"
    />
  )}

  <div class="front-overlay absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent" />

  <div class="front-caption absolute bottom-0 left-0 right-0 p-4">
    <div class="text-sm font-semibold text-white">{title}</div>
    <div class="mt-1 text-xs text-white/55">
      <span class="tap-hint">Tap to read</span>
      <span class="hover-hint">↗ hover to explore</span>
    </div>
  </div>

  <div class="back-panel absolute inset-0 flex flex-col justify-center p-6" aria-hidden="true">
    <div class="text-sm font-bold text-white mb-2">{title}</div>
    <p class="text-sm leading-relaxed text-white/80">{text}</p>
    <div class="mt-4 text-xs text-white/35 tap-close-hint">Tap again to close</div>
  </div>
</button>

<style>
  .back-panel {
    background: rgba(15, 32, 24, 0.90);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .front-media {
    transition: opacity 280ms ease, transform 600ms ease;
  }

  .front-overlay,
  .front-caption {
    transition: opacity 280ms ease;
  }

  .hover-hint { display: none; }

  /* ── Mobile tap ─────────────────────────── */
  .world-tile[aria-pressed="true"] .back-panel     { opacity: 1; }
  .world-tile[aria-pressed="true"] .front-media    { opacity: 0.2; transform: scale(1.04); }
  .world-tile[aria-pressed="true"] .front-overlay,
  .world-tile[aria-pressed="true"] .front-caption  { opacity: 0; }
  .world-tile[aria-pressed="true"] .tap-close-hint { display: block; }

  /* ── Desktop hover ──────────────────────── */
  @media (hover: hover) {
    .tap-hint  { display: none; }
    .hover-hint { display: inline; }
    .tap-close-hint { display: none !important; }

    .world-tile:hover .back-panel    { opacity: 1; }
    .world-tile:hover .front-media   { opacity: 0.2; transform: scale(1.04); }
    .world-tile:hover .front-overlay,
    .world-tile:hover .front-caption { opacity: 0; }
  }
</style>

<script is:inline>
  if (!window.__worldTileBound) {
    window.__worldTileBound = true;
    document.addEventListener("click", (e) => {
      // On hover-capable devices, clicks do nothing — hover handles it
      if (window.matchMedia("(hover: hover)").matches) return;

      const tile = e.target.closest(".world-tile");
      if (!tile) return;

      const isPressed = tile.getAttribute("aria-pressed") === "true";
      tile.setAttribute("aria-pressed", isPressed ? "false" : "true");

      const vid = tile.querySelector("video");
      if (vid) {
        if (!isPressed) vid.play().catch(() => {});
        else vid.pause();
      }
    });
  }
</script>