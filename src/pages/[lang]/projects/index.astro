---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteShell from "../../../components/SiteShell.astro";
import { projects } from "../../../content/projects";
import { ui } from "../../../i18n/ui";
import { isLang } from "../../../i18n/utils";
import ProjectsGrid from "../../../components/ProjectsGrid.jsx";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "nl" } },
  ];
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) throw new Error("Invalid lang");
const t = ui[lang];

const totalTags = new Set(projects.flatMap(p => p.tags)).size;
---

<BaseLayout lang={lang} title={`${t.nav.projects} — Pierina Lopez`}>
  <SiteShell active="projects" lang={lang}>
    <div class="max-w-6xl">

      <!-- Header -->
      <header class="rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-8">

        <!-- Pill badge -->
        <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium mb-4"
              style="color:#C96B4A; border-color:rgba(201,107,74,0.30); background:rgba(201,107,74,0.10);">
          <span class="w-1.5 h-1.5 rounded-full" style="background:#C96B4A;"></span>
          Case studies
        </span>

        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight bg-gradient-to-br from-white to-white/55 bg-clip-text text-transparent">
          {t.nav.projects}
        </h1>
        <p class="mt-3 text-white/60 leading-relaxed text-sm sm:text-base max-w-xl">
          Context, what I built, and what I learned — written for IT professionals.
        </p>

        <!-- Stat bar -->
        <div class="mt-5 flex flex-wrap gap-3">
          <div class="rounded-xl border px-3 py-2 flex items-baseline gap-1.5"
               style="background:rgba(201,107,74,0.08); border-color:rgba(201,107,74,0.20);">
            <span class="text-sm font-bold" style="color:#C96B4A;">{projects.length}</span>
            <span class="text-[10px] text-white/35 uppercase tracking-widest">Projects</span>
          </div>
          <div class="rounded-xl border px-3 py-2 flex items-baseline gap-1.5"
               style="background:rgba(143,175,147,0.08); border-color:rgba(143,175,147,0.20);">
            <span class="text-sm font-bold" style="color:#8FAF93;">{totalTags}</span>
            <span class="text-[10px] text-white/35 uppercase tracking-widest">Technologies</span>
          </div>
          <div class="rounded-xl border px-3 py-2 flex items-baseline gap-1.5"
               style="background:rgba(201,191,154,0.08); border-color:rgba(201,191,154,0.20);">
            <span class="text-sm font-bold" style="color:#C9BF9A;">2025</span>
            <span class="text-[10px] text-white/35 uppercase tracking-widest">Latest</span>
          </div>
        </div>
      </header>

      <!-- Filters + Grid (React) -->
      <ProjectsGrid client:load lang={lang} projects={projects} />
    </div>
  </SiteShell>
</BaseLayout>