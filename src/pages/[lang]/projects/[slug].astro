---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteShell from "../../../components/SiteShell.astro";
import { projects } from "../../../content/projects";
import { ui } from "../../../i18n/ui";
import { isLang } from "../../../i18n/utils";

export async function getStaticPaths() {
  const langs = ["en", "es", "nl"] as const;
  return langs.flatMap((lang) =>
    projects.map((p) => ({ params: { lang, slug: p.slug } }))
  );
}

const { lang, slug } = Astro.params;
if (!lang || !isLang(lang)) throw new Error("Invalid lang");
const t = ui[lang];

const project = projects.find((p) => p.slug === slug);
if (!project) throw new Error("Project not found");


const index = projects.findIndex((p) => p.slug === slug);
const prev = index > 0 ? projects[index - 1] : null;
const next = index < projects.length - 1 ? projects[index + 1] : null;

const accentTag = project.tags[0] ?? "";
const TAG_COLOR: Record<string, string> = {
  IoT: "#8FAF93", "Computer Vision": "#C96B4A", Web: "#C9BF9A",
  AI: "#C96B4A", NLP: "#C96B4A", RAG: "#C96B4A",
  Python: "#8FAF93", Unity: "#C9BF9A", Agile: "#C9BF9A", "Raspberry Pi": "#8FAF93",
};
const accent = TAG_COLOR[accentTag] ?? "#C96B4A";
---

<BaseLayout lang={lang} title={`${project.title} — ${t.nav.projects}`}>
  <SiteShell active="projects" lang={lang}>
    <div class="max-w-5xl">

      <!-- Back link -->
      <a href={`/${lang}/projects`}
         class="inline-flex items-center gap-2 text-sm text-white/50 hover:text-white transition mb-5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
        Back to projects
      </a>

      <!-- Cover hero -->
      <header class="overflow-hidden rounded-3xl border border-white/10">
        <div class="relative aspect-[16/8]">
          <img src={project.cover} alt={project.title}
               class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent"></div>

          <!-- Year badge -->
          <div class="absolute top-4 right-4">
            <span class="rounded-full px-2.5 py-1 text-[11px] font-semibold border"
                  style={`color:${accent}; border-color:${accent}40; background:${accent}20;`}>
              {project.year}
            </span>
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{project.title}</h1>
            <p class="mt-2 text-white/70 leading-relaxed">{project.subtitle}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => {
                const c = TAG_COLOR[tag] ?? "rgba(255,255,255,0.55)";
                return (
                  <span class="rounded-full px-2.5 py-0.5 text-[11px] font-medium border"
                        style={`color:${c}; border-color:${c}35; background:${c}14;`}>
                    {tag}
                  </span>
                );
              })}
            </div>
          </div>
        </div>
      </header>

      <!-- Artifacts / links bar -->
      {project.links?.length ? (
        <section class="mt-5 rounded-3xl border border-white/10 bg-white/5 p-5 sm:p-6">
          <div class="flex items-center justify-between gap-4 flex-wrap">
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-1.5 rounded-full" style={`background:${accent};`}></div>
              <h2 class="text-sm font-semibold">Artifacts</h2>
            </div>
            <div class="flex flex-wrap gap-2">
              {project.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer"
                   class="rounded-xl border px-4 py-2 text-sm font-medium transition hover:opacity-80"
                   style={`color:${accent}; border-color:${accent}40; background:${accent}12;`}>
                  {l.label} ↗
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null}

      <!-- Demo video -->
      {project.videoSrc ? (
        <section class="mt-5 overflow-hidden rounded-3xl border border-white/10 bg-white/5">
          <div class="p-5 sm:p-6 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-1.5 h-1.5 rounded-full" style={`background:${accent};`}></div>
              <h2 class="text-sm font-semibold">Demo video</h2>
            </div>
            <a href={project.videoSrc} target="_blank" rel="noopener noreferrer"
               class="text-xs text-white/50 hover:text-white transition">
              Open fullscreen →
            </a>
          </div>
          <video class="w-full bg-black" controls playsinline preload="metadata">
            <source src={project.videoSrc} type="video/mp4" />
          </video>
        </section>
      ) : null}

      <!-- Content sections -->
      <div class="mt-5 grid gap-4">

        <!-- Context -->
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6"
             style={`border-left: 3px solid ${accent}60;`}>
          <h2 class="text-base font-bold mb-3" style={`color:${accent};`}>Context</h2>
          <p class="text-white/70 leading-relaxed text-sm">{project.sections.context}</p>
        </div>

        <!-- Role + Stack -->
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-base font-bold mb-3" style={`color:${accent};`}>My role</h2>
            <ul class="space-y-2.5">
              {project.sections.role.map((x) => (
                <li class="flex gap-3 text-sm text-white/70 leading-relaxed">
                  <span class="mt-[6px] w-1.5 h-1.5 rounded-full shrink-0" style={`background:${accent};`}></span>
                  {x}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-base font-bold mb-3" style={`color:${accent};`}>Stack</h2>
            <div class="flex flex-wrap gap-1.5">
              {project.sections.stack.map((x) => {
                const c = TAG_COLOR[x] ?? accent;
                return (
                  <span class="rounded-lg px-2.5 py-1 text-xs text-white/65"
                        style={`background:${c}12; border:1px solid ${c}25;`}>
                    {x}
                  </span>
                );
              })}
            </div>
          </div>
        </div>

        <!-- What I built -->
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6"
             style={`border-left: 3px solid ${accent}60;`}>
          <h2 class="text-base font-bold mb-3" style={`color:${accent};`}>What I built</h2>
          <ul class="space-y-2.5">
            {project.sections.built.map((x) => (
              <li class="flex gap-3 text-sm text-white/70 leading-relaxed">
                <span class="mt-[6px] w-1.5 h-1.5 rounded-full shrink-0" style={`background:${accent};`}></span>
                {x}
              </li>
            ))}
          </ul>
        </div>

        <!-- What I learned -->
        <div class="rounded-3xl border border-white/10 bg-white/5 p-6"
             style={`border-left: 3px solid rgba(143,175,147,0.60);`}>
          <h2 class="text-base font-bold mb-3" style="color:#8FAF93;">What I learned</h2>
          <ul class="space-y-2.5">
            {project.sections.learned.map((x) => (
              <li class="flex gap-3 text-sm text-white/70 leading-relaxed">
                <span class="mt-[6px] w-1.5 h-1.5 rounded-full shrink-0" style="background:#8FAF93;"></span>
                {x}
              </li>
            ))}
          </ul>
        </div>

        <!-- Gallery -->
        {project.gallery.length > 0 && (
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-base font-bold mb-4" style={`color:${accent};`}>Gallery</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {project.gallery.map((img, idx) => (
                <button type="button"
                  class="gallery-thumb group overflow-hidden rounded-2xl border border-white/10 text-left block"
                  data-src={img.src} data-alt={img.alt}
                  aria-label={`Open image ${idx + 1}: ${img.alt}`}>
                  <img src={img.src} alt={img.alt}
                       class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                       loading="lazy" />
                </button>
              ))}
            </div>

            <!-- Lightbox -->
            <div id="lightbox" class="fixed inset-0 z-[9999] hidden">
              <div id="lightboxBackdrop" class="absolute inset-0 bg-black/85 backdrop-blur-sm"></div>
              <div class="relative mx-auto flex h-full max-w-6xl items-center justify-center p-4">
                <button id="lightboxClose" type="button"
                  class="absolute right-4 top-4 rounded-xl border border-white/15 bg-white/10 px-3 py-2 text-sm text-white hover:bg-white/20 transition">
                  ✕ Close
                </button>
                <img id="lightboxImg" alt="" class="max-h-[85vh] w-auto max-w-full rounded-2xl border border-white/10 shadow-2xl" />
                <div id="lightboxCaption" class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full border border-white/15 bg-black/50 px-4 py-2 text-xs text-white/80 backdrop-blur"></div>
              </div>
            </div>

            <script is:inline>
              const lb = document.getElementById("lightbox");
              const lbImg = document.getElementById("lightboxImg");
              const lbCap = document.getElementById("lightboxCaption");
              const closeBtn = document.getElementById("lightboxClose");
              const backdrop = document.getElementById("lightboxBackdrop");
              function openLightbox(src, alt) {
                lbImg.src = src; lbImg.alt = alt || "";
                lbCap.textContent = alt || "";
                lb.classList.remove("hidden");
                document.body.style.overflow = "hidden";
              }
              function closeLightbox() {
                lb.classList.add("hidden"); lbImg.src = "";
                document.body.style.overflow = "";
              }
              document.querySelectorAll(".gallery-thumb").forEach((btn) => {
                btn.addEventListener("click", () => openLightbox(btn.dataset.src, btn.dataset.alt));
              });
              closeBtn?.addEventListener("click", closeLightbox);
              backdrop?.addEventListener("click", closeLightbox);
              window.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && !lb.classList.contains("hidden")) closeLightbox();
              });
            </script>
          </div>
        )}
      </div>

      <!-- Prev / Next nav -->
      <nav class="mt-6 grid gap-3 sm:grid-cols-2">
        {prev ? (
          <a href={`/${lang}/projects/${prev.slug}`}
             class="rounded-2xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition group flex items-center gap-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-white/40 group-hover:text-white transition"><polyline points="15 18 9 12 15 6"/></svg>
            <div class="min-w-0">
              <div class="text-[10px] text-white/35 uppercase tracking-widest">Previous</div>
              <div class="text-sm font-medium text-white/75 group-hover:text-white transition truncate">{prev.title}</div>
            </div>
          </a>
        ) : <div />}
        {next ? (
          <a href={`/${lang}/projects/${next.slug}`}
             class="rounded-2xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition group flex items-center justify-end gap-3 text-right">
            <div class="min-w-0">
              <div class="text-[10px] text-white/35 uppercase tracking-widest">Next</div>
              <div class="text-sm font-medium text-white/75 group-hover:text-white transition truncate">{next.title}</div>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-white/40 group-hover:text-white transition"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        ) : <div />}
      </nav>

    </div>
  </SiteShell>
</BaseLayout>