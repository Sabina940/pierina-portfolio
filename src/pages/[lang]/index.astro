---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteShell from "../../components/SiteShell.astro";
import HeroBg from "../../components/HeroBg.jsx";
import { ui } from "../../i18n/ui";
import { isLang } from "../../i18n/utils";

export async function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "nl" } },
  ];
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) throw new Error("Invalid lang");

const t = ui[lang];
---

<BaseLayout lang={lang} title="Pierina Lopez — Portfolio">
  <SiteShell active="home" lang={lang}>

    <!-- ── HERO ──────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden rounded-3xl border border-white/10 bg-white/5 p-6 sm:p-10">
      <HeroBg client:load />

      <!-- Dot grid texture -->
      <div
        class="absolute inset-0 opacity-[0.04] pointer-events-none"
        style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 22px 22px;"
      />

      <!-- Profile photo — cinematic right-side fade -->
      <div class="absolute right-0 top-0 h-full w-[45%] sm:w-[38%] pointer-events-none select-none hidden sm:block">
        <!-- colour glow blobs -->
        <div class="absolute right-10 top-1/2 -translate-y-1/2 h-72 w-72 rounded-full bg-[#C96B4A]/20 blur-3xl" />
        <div class="absolute right-20 top-1/4 h-48 w-48 rounded-full bg-[#8FAF93]/15 blur-2xl" />
        <!-- photo with left-edge fade so it melts into the hero -->
        <img
          src="/assets/profile.png"
          alt="Pierina Lopez"
          class="absolute inset-0 h-full w-full object-cover object-top"
          style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 42%); mask-image: linear-gradient(to right, transparent 0%, black 42%);"
        />
      </div>

      <div class="relative z-10 max-w-xl sm:max-w-2xl">

        <!-- Pill badge with pulsing dot -->
        <span class="inline-flex items-center gap-2 rounded-full border border-[#C96B4A]/30 bg-[#C96B4A]/10 px-3 py-1.5 text-xs text-[#C96B4A] font-medium tracking-wide">
          <span class="relative flex h-1.5 w-1.5 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#C96B4A] opacity-60"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[#C96B4A]"></span>
          </span>
          {t.hero.pill}
        </span>

        <!-- Title with gradient -->
        <h1 class="mt-5 text-4xl sm:text-6xl font-bold tracking-tight leading-[1.1]">
          <span class="bg-gradient-to-br from-white via-white to-white/50 bg-clip-text text-transparent">
            {t.hero.title}
          </span>
        </h1>

        <!-- Body -->
        <p class="mt-5 max-w-xl text-white/60 text-sm sm:text-base leading-relaxed">
          {t.hero.body}
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`/${lang}/internship`}
            class="rounded-xl border border-[#C96B4A]/40 bg-[#C96B4A]/15 px-4 py-2 text-sm font-semibold text-[#C96B4A] hover:bg-[#C96B4A]/25 transition"
          >
            {t.hero.cta1}
          </a>
          <a
            href={`/${lang}/projects`}
            class="rounded-xl border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10 transition"
          >
            {t.hero.cta2}
          </a>
          <a
            href={`/${lang}/cv`}
            class="rounded-xl border border-white/10 bg-transparent px-4 py-2 text-sm font-semibold text-white/60 hover:text-white hover:bg-white/5 transition"
          >
            {t.hero.cta3}
          </a>
        </div>
      </div>

      <!-- Feature cards -->
      <div class="relative z-10 mt-10 grid gap-3 sm:grid-cols-3">

        <!-- Computer Vision -->
        <div class="group rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-4 flex gap-3 hover:border-[#C96B4A]/25 hover:bg-[#C96B4A]/5 transition duration-300">
          <div class="shrink-0 mt-0.5 rounded-lg bg-[#C96B4A]/15 p-2">
            <svg class="h-4 w-4 text-[#C96B4A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold">{t.cards.cv.title}</div>
            <div class="mt-1 text-xs text-white/55 leading-relaxed">{t.cards.cv.body}</div>
          </div>
        </div>

        <!-- Automation -->
        <div class="group rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-4 flex gap-3 hover:border-[#8FAF93]/25 hover:bg-[#8FAF93]/5 transition duration-300">
          <div class="shrink-0 mt-0.5 rounded-lg bg-[#8FAF93]/15 p-2">
            <svg class="h-4 w-4 text-[#8FAF93]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold">{t.cards.auto.title}</div>
            <div class="mt-1 text-xs text-white/55 leading-relaxed">{t.cards.auto.body}</div>
          </div>
        </div>

        <!-- IoT -->
        <div class="group rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm p-4 flex gap-3 hover:border-[#C9BF9A]/25 hover:bg-[#C9BF9A]/5 transition duration-300">
          <div class="shrink-0 mt-0.5 rounded-lg bg-[#C9BF9A]/15 p-2">
            <svg class="h-4 w-4 text-[#C9BF9A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
              <line x1="12" y1="20" x2="12.01" y2="20"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold">{t.cards.iot.title}</div>
            <div class="mt-1 text-xs text-white/55 leading-relaxed">{t.cards.iot.body}</div>
          </div>
        </div>

      </div>
    </section>

    <!-- ── BOTTOM GRID ────────────────────────────────────────────────────── -->
    <div class="mt-5 grid gap-5 sm:grid-cols-2">

      <!-- What you'll find -->
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-lg font-semibold">{t.sections.find}</h2>
        <ul class="mt-5 space-y-4">
          {t.sections.findBullets.map((b: string) => (
            <li class="flex items-start gap-3 text-sm text-white/65 leading-relaxed">
              <span class="mt-[5px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#C96B4A]" />
              {b}
            </li>
          ))}
        </ul>
      </div>

      <!-- At a glance -->
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-lg font-semibold">At a glance</h2>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <div class="rounded-2xl border border-white/8 bg-white/5 p-4 text-center">
            <div class="text-2xl font-bold text-[#C96B4A]">5+</div>
            <div class="text-[10px] text-white/45 mt-1 uppercase tracking-widest">Projects</div>
          </div>
          <div class="rounded-2xl border border-white/8 bg-white/5 p-4 text-center">
            <div class="text-2xl font-bold text-[#8FAF93]">3</div>
            <div class="text-[10px] text-white/45 mt-1 uppercase tracking-widest">Languages</div>
          </div>
          <div class="rounded-2xl border border-white/8 bg-white/5 p-4 text-center">
            <div class="text-2xl font-bold text-[#C9BF9A]">AEC</div>
            <div class="text-[10px] text-white/45 mt-1 uppercase tracking-widest">Background</div>
          </div>
          <div class="rounded-2xl border border-white/8 bg-white/5 p-4 text-center">
            <div class="text-2xl font-bold text-white/75">IoT</div>
            <div class="text-[10px] text-white/45 mt-1 uppercase tracking-widest">Focus</div>
          </div>
        </div>
      </div>

    </div>

  </SiteShell>
</BaseLayout>